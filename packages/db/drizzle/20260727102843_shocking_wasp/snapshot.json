    {
      "value": "\"authority_status\" <> 'PAID' OR \"paid_through\" IS NOT NULL",
      "name": "account_billing_paid_has_period",
      "entityType": "checks",
      "schema": "public",
      "table": "account_billing_states"
    },
    {
      "value": "(\"grace_started_at\" IS NULL) = (\"grace_ends_at\" IS NULL)",
