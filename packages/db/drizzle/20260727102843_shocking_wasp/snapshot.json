      "entityType": "checks",
      "schema": "public",
      "table": "account_billing_states"
    },
    {
      "value": "\"authority_status\" <> 'PAST_DUE' OR \"grace_ends_at\" IS NOT NULL",
      "name": "account_billing_past_due_has_grace",
      "entityType": "checks",
      "schema": "public",
      "table": "account_billing_states"
    },
    {
      "value": "extract(epoch from (\"ends_at\" - \"started_at\")) = 1209600",
