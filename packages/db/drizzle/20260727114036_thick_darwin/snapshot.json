    {
      "value": "\"authority_status\" <> 'PAID' OR \"paid_through\" IS NOT NULL",
      "name": "account_billing_paid_has_period",
      "entityType": "checks",
      "schema": "public",
      "table": "account_billing_states"
    },
    {
      "value": "(\"grace_started_at\" IS NULL) = (\"grace_ends_at\" IS NULL)",
      "name": "account_billing_grace_is_complete",
      "entityType": "checks",
      "schema": "public",
      "table": "account_billing_states"
    },
    {
      "value": "\"authority_status\" <> 'PAST_DUE' OR \"grace_ends_at\" IS NOT NULL",
      "name": "account_billing_past_due_has_grace",
      "entityType": "checks",
      "schema": "public",
      "table": "account_billing_states"
    },
    {
      "value": "extract(epoch from (\"ends_at\" - \"started_at\")) = 1209600",
      "name": "account_trials_exact_duration",
      "entityType": "checks",
      "schema": "public",
      "table": "account_trials"
    },
    {
      "value": "\"total_snippet_count\" >= 0",
      "name": "storage_cleanup_total_nonnegative",
      "entityType": "checks",
      "schema": "public",
      "table": "storage_cleanup_intents"
    },
    {
      "value": "(\"attempt_id\" IS NULL) = (\"lease_expires_at\" IS NULL)",
      "name": "storage_cleanup_lease_is_complete",
      "entityType": "checks",
      "schema": "public",
      "table": "storage_cleanup_intents"
    }
