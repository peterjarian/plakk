{
  "name": "@plakk/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/main.ts",
    "build": "vp pack src/main.ts --format esm --out-dir dist",
    "start": "node dist/main.mjs",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.0-beta.92",
    "@effect/platform-node": "4.0.0-beta.92",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.217.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@plakk/db": "workspace:*",
    "@plakk/shared": "workspace:*",
    "@workos-inc/node": "^10.7.0",
    "dotenv": "^17.4.2",
    "effect": "catalog:",
    "jose": "^6.2.3"
  },
