# Human-owned inputs for local development.
# Copy this file to .env.local. Never commit real credentials.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/plakk

WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
# Use a random value containing at least 32 characters.
WORKOS_COOKIE_PASSWORD=

# Optional: isolate Electron state for a particular development checkout.
# PLAKK_DESKTOP_USER_DATA_PATH=/absolute/path/to/plakk-development-data

# Do not add local URLs, ports, or redirect URIs here. `vp run dev` derives them
# from this device's Tailscale MagicDNS name and supplies them to each app.
